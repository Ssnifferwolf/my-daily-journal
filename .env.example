# Copy to .env (never commit .env). Both values come from Supabase -> Project Settings -> API.
# The publishable/anon key is meant to be public; security comes from the Row Level Security policies.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
